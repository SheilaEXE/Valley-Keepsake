<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ValleyKeepsake</AssemblyName>
    <Product>Valley Keepsake</Product>
    <AssemblyTitle>Valley Keepsake</AssemblyTitle>
    <RootNamespace>TradutorModsStardew</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\Languages\*.json" Link="Languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\Languages\README.md" Link="Languages\README.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\PixelifySans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PixelifySans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Junimo*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\green_debris.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\pink_debris.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PaintPalette-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Junimo-Note.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DialogueBoxBorder.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SlimeHutchBorder.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Slime.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\GardenBackground.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\GardenFrame.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
